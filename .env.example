# Copiar este archivo como .env y completar las claves. El .env no se sube al repositorio.
# En nombres y usuarios usar solo letras, números y _.

# Clave para firmar y validar los tokens. Tiene que ser la misma en el gateway y en Usuarios.
JWT_SECRET=cambiar-por-una-clave-larga

# Contraseña de root de los tres MySQL.
MYSQL_ROOT_PASSWORD=cambiar

# Base de Usuarios: nombre, usuario con el que se conecta el servicio y su contraseña.
USUARIOS_DB_NAME=usuarios
USUARIOS_DB_USER=usuarios
USUARIOS_DB_PASSWORD=cambiar

# Base de Inventario.
INVENTARIO_DB_NAME=inventario
INVENTARIO_DB_USER=inventario
INVENTARIO_DB_PASSWORD=cambiar

# Base de logs.
LOGS_DB_NAME=observabilidad
LOGS_DB_USER=logs
LOGS_DB_PASSWORD=cambiar

# Contraseña del usuario admin de Grafana.
GRAFANA_ADMIN_PASSWORD=cambiar
