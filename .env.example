# Copiar este archivo como .env y completar las claves. El .env no se sube al repositorio.
# En nombres y usuarios usar solo letras, números y _.

# Clave para firmar y validar los tokens. Tiene que ser la misma en el gateway y en Usuarios.
JWT_SECRET=cambiar-por-una-clave-larga

# Contraseña de root de los tres MySQL.
MYSQL_ROOT_PASSWORD=cambiar

# Base de Usuarios: nombre, usuario con el que se conecta el servicio y su contraseña.
USUARIOS_DB_NAME=usuarios
USUARIOS_DB_USER=usuarios
USUARIOS_DB_PASSWORD=cambiar

# Base de Sucursales.
SUCURSALES_DB_NAME=sucursales
SUCURSALES_DB_USER=sucursales
SUCURSALES_DB_PASSWORD=cambiar

# Base de Inventario.
INVENTARIO_DB_NAME=inventario
INVENTARIO_DB_USER=inventario
INVENTARIO_DB_PASSWORD=cambiar

# Base de Transferencias (MongoDB): usuario y contraseña.
MONGO_USER=transferencias
MONGO_PASSWORD=cambiar

# RabbitMQ: usuario y contraseña, también para entrar a http://localhost:15672.
RABBITMQ_USER=stock
RABBITMQ_PASSWORD=cambiar

# Rumbo, el servicio de traslados de otro grupo. Las credenciales las entrega su equipo y no se suben al repositorio.
# Sin RUMBO_URL, las transferencias se crean pero no se reservan en Rumbo (así corremos las pruebas de carga).
RUMBO_URL=https://rumbo-gateway.onrender.com
RUMBO_CLIENT_ID=cambiar
RUMBO_CLIENT_SECRET=cambiar

# Base de logs.
LOGS_DB_NAME=observabilidad
LOGS_DB_USER=logs
LOGS_DB_PASSWORD=cambiar

# Asistente: el modelo de lenguaje, con la API compatible con OpenAI (ADR-018). La clave de Groq se saca en
# https://console.groq.com/keys y no se sube al repositorio. Sin clave, el chat responde que no está disponible.
MODEL_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-120b
MODEL_API_KEY=cambiar
